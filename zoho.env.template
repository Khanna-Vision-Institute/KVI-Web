# Copy this file to .env and update with your real Zoho credentials before running the server.
ZOHO_CLIENT_ID=YOUR_ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=YOUR_ZOHO_CLIENT_SECRET
ZOHO_REFRESH_TOKEN=YOUR_ZOHO_REFRESH_TOKEN
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# Heritage Family — auto-sync Zoho "Doctor Office" (Accounts module) → /HeritageFamily
# Prefer Bitrix below when cut over. Keep Zoho OFF if Bitrix is ON.
# HERITAGE_ZOHO_SYNC_ENABLED=false
# ZOHO_HERITAGE_CRM_MODULE=Accounts
# ZOHO_HERITAGE_CRM_VIEW_ID=
# Leave blank unless you have a working API custom-view id (browser URL id often fails).
# ZOHO_HERITAGE_EXPAND_CONTACTS=true
# ZOHO_HERITAGE_SYNC_CRON=0 */6 * * *
# Once daily (minimal CPU): ZOHO_HERITAGE_SYNC_CRON=0 3 * * *
# ZOHO_HERITAGE_SYNC_SECRET=choose-a-long-random-secret
# ZOHO_HERITAGE_DIRECTORY_HUBS=HeritageFamily

# Heritage Family — Bitrix24 Doctor Office SPA (entityTypeId 1038) → /HeritageFamily
# No website UI changes; same referral-offices.json + MDVIP merge as Zoho.
# BITRIX_WEBHOOK_URL=https://b24-xxxxx.bitrix24.in/rest/10/YOUR_TOKEN/
# HERITAGE_BITRIX_SYNC_ENABLED=true
# HERITAGE_BITRIX_ENTITY_TYPE_ID=1038
# HERITAGE_BITRIX_SYNC_CRON=0 */6 * * *
# HERITAGE_BITRIX_SYNC_SECRET=choose-a-long-random-secret
# HERITAGE_BITRIX_DIRECTORY_HUBS=HeritageFamily

# Email transport configuration for Vision Quest summaries
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
VISION_QUEST_EMAIL_TO=nisha.indianiayez@gmail.com
VISION_QUEST_EMAIL_FROM="Vision Quest" <no-reply@yourdomain.com>
