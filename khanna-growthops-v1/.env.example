# Khanna GrowthOps v1 — local dev configuration
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Leave MOCK_MODE=true to run on sample data with no credentials.

# ── Core ─────────────────────────────────────────────────────────────────────
MOCK_MODE=true
PORT=8080
GROWTHOPS_REQUIRE_AUTH=true
GROWTHOPS_TRUST_PROXY=true
GROWTHOPS_ADMIN_USER=seo-team
GROWTHOPS_ADMIN_PASSWORD=change-me
# Set GROWTHOPS_CRON=true to run the daily brief at 8am on weekdays (laptop must be on)
GROWTHOPS_CRON=false

# ── Site Health (404 / 502 checker for khannainstitute.com) ───────────────────
# Manual by default (dashboard "Run check now" or POST /api/site-health/run).
# Set SITE_HEALTH_CHECK_ENABLED=true only to enable automatic cron.
SITE_HEALTH_CHECK_ENABLED=false
SITE_HEALTH_CHECK_CRON=*/5 * * * *
SITE_HEALTH_BASE_URL=https://khannainstitute.com
# Comma-separated paths (or full URLs) that must stay healthy
SITE_HEALTH_PATHS=/,/contact/schedule-consultation/,/contact/forms/,/HeritageFamily,/procedures/laser-vision/smile-laser/,/procedures/laser-vision/lasik/,/procedures/lens-solutions/pie/,/procedures/lens-solutions/evo-icl/,/patients/results/testimonials/,/pricing-financing/special-offers/,/seminar-rsvp.html
SITE_HEALTH_TIMEOUT_MS=12000
SITE_HEALTH_CONCURRENCY=4
# Optional Slack/Teams/webhook URL for critical alerts
SITE_HEALTH_WEBHOOK_URL=

# Publish approved blog_draft items to your CMS endpoint/webhook.
# Keep OFF until the endpoint is ready to accept POST JSON.
BLOG_PUBLISH_ENABLED=true
BLOG_PUBLISH_ENDPOINT=http://127.0.0.1:3000/api/internal/growthops/publish-blog
BLOG_PUBLISH_TOKEN=
BLOG_PUBLISH_TIMEOUT_MS=12000

# ── OpenAI / ChatGPT (AI drafts) ──────────────────────────────────────────────
# Used to generate blog/newsletter drafts. If blank, template drafts are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Google (Search Console + GA4, READ-ONLY) ──────────────────────────────────
# One OAuth client covers both APIs. Run `npm run auth:google` to get the refresh token.
# Scopes: https://www.googleapis.com/auth/webmasters.readonly
#         https://www.googleapis.com/auth/analytics.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Set false until Search Console property access is granted
GSC_ENABLED=true
# (URL-prefix form "https://khannainstitute.com/" or domain form "sc-domain:khannainstitute.com")
GSC_SITE_URL=https://khannainstitute.com/

# GA4 Data API
GA4_PROPERTY_ID=
# The GA4 event counted as a "consult intent" conversion (e.g. consult_intent, generate_lead)
GA4_CONSULT_EVENT=consult_intent

# ── Zoho CRM (READ-ONLY in phase 1) ───────────────────────────────────────────
# Run `npm run auth:zoho` to get the refresh token.
# Data center: com | in | eu | com.au
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com
ZOHO_LEAD_MODULE=Leads
# Lead Status value(s) that mean a consult was booked (from Leads → Lead Status dropdown).
# Comma-separate multiple, e.g. APPT Setup,Consultation Booked
# Leads = booked consults in this CRM. Leave blank to count all recent leads.
ZOHO_LEAD_STATUS_BOOKED=
ZOHO_DEAL_MODULE=Deals
# Only used if ZOHO_LEAD_STATUS_BOOKED is blank (Deals are empty in most Khanna orgs)
ZOHO_DEAL_STAGE_BOOKED=Closed Won

# Phase 6 (OPTIONAL, OFF by default): write Growth Tasks back to Zoho on approval.
# Leave false until you explicitly want approvals to create CRM tasks.
ZOHO_WRITE_ENABLED=false
# Optional CRM user id to own created tasks (blank = API user)
ZOHO_TASKS_OWNER_ID=

# ── Ads (OPTIONAL stubs — not wired in phase 1) ───────────────────────────────
GOOGLE_ADS_CUSTOMER_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── Legacy / unused ───────────────────────────────────────────────────────────
# This project uses Anthropic, not OpenAI. Kept only for backwards compatibility.
OPENAI_API_KEY=
