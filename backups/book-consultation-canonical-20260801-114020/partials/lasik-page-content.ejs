<style>
    /* Reset and Base Styles */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    
    :root {
        --primary: #667eea;
        --secondary: #764ba2;
        --accent: #00c9ff;
        --dark: #2c3e50;
        --light: #f8f9fa;
    }
    
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        line-height: 1.6;
        color: var(--dark);
    }
    
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }
    
    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 100px 20px;
        text-align: center;
    }
    
    .hero-section h1 {
        font-size: 3em;
        margin-bottom: 20px;
        font-weight: 800;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }
    
    .hero-subheading {
        font-size: 1.5em;
        margin-bottom: 40px;
        opacity: 0.95;
    }
    
    .hero-video {
        max-width: 800px;
        margin: 40px auto;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    
    .hero-video video {
        width: 100%;
        display: block;
    }
    
    .hero-cta {
        margin: 40px 0;
    }
    
    .cta-primary {
        background: linear-gradient(135deg, #00c9ff 0%, #92fe9d 100%);
        color: white;
        padding: 20px 50px;
        font-size: 1.3em;
        font-weight: bold;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    
    .cta-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    }
    
    a.cta-primary {
        cursor: pointer;
    }
    
    .urgency-text {
        margin-top: 15px;
        font-size: 1.2em;
        color: #fff200;
        font-weight: 600;
    }
    
    .trust-badges {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin-top: 40px;
        flex-wrap: wrap;
    }
    
    .trust-badges span {
        font-size: 1.1em;
        background: rgba(255,255,255,0.2);
        padding: 10px 20px;
        border-radius: 25px;
        backdrop-filter: blur(10px);
    }
    
    /* Testimonials */
    .video-testimonials {
        padding: 80px 20px;
        background: white;
    }
    
    .video-testimonials h2 {
        text-align: center;
        font-size: 2.5em;
        margin-bottom: 50px;
        color: var(--dark);
    }
    
    .testimonial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .testimonial-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }
    
    .testimonial-card:hover {
        transform: translateY(-5px);
    }
    
    .testimonial-card.featured {
        grid-column: 1 / -1;
        max-width: 700px;
        margin: 0 auto;
    }
    
    .testimonial-card video {
        width: 100%;
        height: 250px;
        object-fit: cover;
    }
    
    .testimonial-card.featured video {
        height: 350px;
    }
    
    .testimonial-info {
        padding: 25px;
    }
    
    .testimonial-info h3 {
        font-size: 1.4em;
        margin-bottom: 5px;
        color: var(--primary);
    }
    
    .testimonial-title {
        color: #666;
        font-size: 0.9em;
        margin-bottom: 15px;
    }
    
    .testimonial-quote {
        font-style: italic;
        color: #555;
        line-height: 1.6;
    }
    
    /* Stats Section */
    .stats-section {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 80px 20px;
        text-align: center;
    }
    
    .stats-section h2 {
        font-size: 2.5em;
        margin-bottom: 50px;
        color: var(--dark);
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
        max-width: 1000px;
        margin: 0 auto;
    }
    
    .stat-card {
        background: white;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    
    .stat-number {
        font-size: 3em;
        font-weight: bold;
        color: var(--primary);
        margin-bottom: 10px;
    }
    
    .stat-label {
        font-size: 1.1em;
        color: #666;
    }
    
    /* Calculator Section */
    .calculator-section {
        padding: 80px 20px;
        background: white;
    }
    
    .calculator-section h2 {
        text-align: center;
        font-size: 2.5em;
        margin-bottom: 50px;
        color: var(--dark);
    }
    
    .calculator-widget {
        max-width: 900px;
        margin: 0 auto;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 50px;
        color: white;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }
    
    .calc-inputs {
        margin-bottom: 40px;
    }
    
    .calc-inputs label {
        display: block;
        margin-bottom: 10px;
        font-weight: 600;
        font-size: 1.1em;
    }
    
    .calc-inputs select,
    .calc-inputs input {
        width: 100%;
        padding: 15px;
        margin-bottom: 25px;
        border: none;
        border-radius: 10px;
        font-size: 1em;
        background: rgba(255,255,255,0.9);
    }
    
    .calc-results {
        background: rgba(255,255,255,0.1);
        border-radius: 15px;
        padding: 30px;
    }
    
    .result-item {
        display: flex;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }
    
    .result-item:last-child {
        border-bottom: none;
    }
    
    .result-item.highlight {
        background: rgba(255,255,255,0.1);
        padding: 20px;
        border-radius: 10px;
        margin-top: 20px;
    }
    
    .price {
        font-size: 1.3em;
        font-weight: bold;
    }
    
    .monthly {
        font-size: 1.5em;
        font-weight: bold;
        color: #fff200;
    }
    
    .breakeven {
        font-size: 1.2em;
        font-weight: bold;
    }
    
    .savings-message {
        background: rgba(255,255,255,0.2);
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        margin-top: 20px;
        font-size: 1.2em;
        font-weight: bold;
    }
    
    /* Comparison Table */
    .procedure-comparison {
        padding: 80px 20px;
        background: #f8f9fa;
    }
    
    .procedure-comparison h2 {
        text-align: center;
        font-size: 2.5em;
        margin-bottom: 50px;
        color: var(--dark);
    }
    
    .comparison-table {
        max-width: 1000px;
        margin: 0 auto;
        overflow-x: auto;
    }
    
    .comparison-table table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border-radius: 15px;
        overflow: hidden;
    }
    
    .comparison-table th {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        text-align: left;
        font-size: 1.1em;
    }
    
    .comparison-table td {
        padding: 20px;
        border-bottom: 1px solid #e0e0e0;
    }
    
    .comparison-table tr:hover {
        background: #f8f9fa;
    }
    
    .comparison-table tr.highlighted {
        background: #e8f5e9;
        font-weight: bold;
    }
    
    .comparison-quiz {
        text-align: center;
        margin-top: 40px;
    }
    
    .quiz-btn {
        background: linear-gradient(135deg, #00c9ff 0%, #92fe9d 100%);
        color: white;
        padding: 20px 40px;
        font-size: 1.2em;
        font-weight: bold;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .quiz-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    }
    
    /* Recovery Timeline */
    .recovery-timeline {
        padding: 80px 20px;
        background: white;
    }
    
    .recovery-timeline h2 {
        text-align: center;
        font-size: 2.5em;
        margin-bottom: 50px;
        color: var(--dark);
    }
    
    .timeline-visual {
        max-width: 1000px;
        margin: 0 auto;
        position: relative;
    }
    
    .timeline-container {
        position: relative;
        padding-left: 50px;
    }
    
    .timeline-container::before {
        content: '';
        position: absolute;
        left: 20px;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
    }
    
    .timeline-item {
        margin-bottom: 60px;
        position: relative;
    }
    
    .time-marker {
        position: absolute;
        left: -40px;
        top: 0;
        background: var(--primary);
        color: white;
        padding: 5px 15px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.9em;
    }
    
    .milestone {
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    
    .milestone h3 {
        color: var(--primary);
        margin-bottom: 10px;
    }
    
    .milestone p {
        color: #666;
        line-height: 1.6;
    }
    
    /* Educational Content */
    .educational-section {
        padding: 80px 20px;
        background: white;
    }
    
    .educational-content {
        max-width: 900px;
        margin: 0 auto;
        line-height: 1.8;
    }
    
    .educational-content h2 {
        font-size: 2.5em;
        margin-bottom: 30px;
        color: var(--dark);
        text-align: center;
    }
    
    .educational-content h3 {
        font-size: 2em;
        margin: 40px 0 20px;
        color: var(--primary);
    }
    
    .educational-content h4 {
        font-size: 1.5em;
        margin: 30px 0 15px;
        color: var(--dark);
    }
    
    .educational-content p {
        margin-bottom: 20px;
        color: #555;
    }
    
    .educational-content ul,
    .educational-content ol {
        margin-bottom: 20px;
    }
    
    .educational-content li {
        margin-bottom: 10px;
        color: #555;
    }
    
    .myth-box {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-left: 4px solid var(--primary);
        padding: 20px;
        margin: 30px 0;
        border-radius: 5px;
    }
    
    .myth-box h4 {
        color: #e74c3c;
        margin: 0 0 10px 0;
    }
    
    /* FAQ Section */
    .faq-section {
        padding: 80px 20px;
        background: white;
    }
    
    .faq-section h2 {
        text-align: center;
        font-size: 2.5em;
        margin-bottom: 50px;
        color: var(--dark);
    }
    
    .faq-grid {
        max-width: 900px;
        margin: 0 auto;
        display: grid;
        gap: 20px;
    }
    
    .faq-item {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    
    .faq-item:hover {
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    
    .faq-item h3 {
        padding: 25px;
        margin: 0;
        font-size: 1.2em;
        color: var(--dark);
        background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
        cursor: pointer;
    }
    
    .faq-item p {
        padding: 25px;
        margin: 0;
        color: #666;
        line-height: 1.8;
    }
    
    /* Location Section */
    .location-specific {
        padding: 80px 20px;
        background: #f8f9fa;
    }
    
    .location-specific h2 {
        text-align: center;
        font-size: 2.5em;
        margin-bottom: 50px;
        color: var(--dark);
    }
    
    .location-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 40px;
        max-width: 1000px;
        margin: 0 auto;
    }
    
    .location-card {
        background: white;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    
    .location-card h3 {
        font-size: 1.8em;
        color: var(--primary);
        margin-bottom: 20px;
    }
    
    .location-card p {
        color: #666;
        line-height: 1.8;
        margin-bottom: 20px;
    }
    
    .location-card address {
        font-style: normal;
        line-height: 1.8;
        color: #666;
        margin: 20px 0;
    }
    
    .location-card a {
        color: var(--primary);
        text-decoration: none;
        font-weight: bold;
    }
    
    /* Final CTA */
    .final-cta-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 100px 20px;
        text-align: center;
        color: white;
    }
    
    .urgency-wrapper h2 {
        font-size: 3em;
        margin-bottom: 20px;
    }
    
    .limited-time {
        font-size: 1.5em;
        color: #fff200;
        margin-bottom: 30px;
    }
    
    .cta-benefits {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin: 40px 0;
        flex-wrap: wrap;
    }
    
    .benefit {
        font-size: 1.2em;
        background: rgba(255,255,255,0.2);
        padding: 10px 20px;
        border-radius: 25px;
        backdrop-filter: blur(10px);
    }
    
    .dual-cta {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 40px 0;
        flex-wrap: wrap;
    }
    
    .cta-primary.large {
        padding: 20px 50px;
        font-size: 1.3em;
    }
    
    .phone-option {
        margin-top: 30px;
        font-size: 1.2em;
    }
    
    /* Responsive Design */
    @media (max-width: 768px) {
        .hero-section h1 {
            font-size: 2em;
        }
        
        .hero-subheading {
            font-size: 1.2em;
        }
        
        .trust-badges {
            flex-direction: column;
            align-items: center;
        }
        
        .testimonial-grid {
            grid-template-columns: 1fr;
        }
        
        .stats-grid {
            grid-template-columns: 1fr;
        }
        
        .calculator-widget {
            padding: 30px;
        }
        
        .location-grid {
            grid-template-columns: 1fr;
        }
        
        .dual-cta {
            flex-direction: column;
        }
        
        .urgency-wrapper h2 {
            font-size: 2em;
        }
    }

    /* LASIK membership pricing — premium layout */
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700&family=Outfit:wght@400;500;600;700;800&display=swap');

    .lasik-pricing {
        --lp-violet: #667eea;
        --lp-plum: #764ba2;
        --lp-deep: #2d1f4e;
        --lp-gold: #c9922a;
        --lp-gold-light: #f4e6c8;
        --lp-silver: #9ca3b8;
        --lp-cyan: #00c9ff;
        position: relative;
        padding: 100px 20px 108px;
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #1a1230;
        overflow: hidden;
        isolation: isolate;
    }

    .lasik-pricing__bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        background: linear-gradient(155deg, #1a1230 0%, #3d2d6b 28%, #5b4a9e 52%, #667eea 78%, #8b9cf5 100%);
    }

    .lasik-pricing__bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 75%);
        pointer-events: none;
    }

    .lasik-pricing__orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(72px);
        pointer-events: none;
        z-index: 0;
    }

    .lasik-pricing__orb--1 {
        width: 400px;
        height: 400px;
        top: -10%;
        left: -5%;
        background: rgba(102, 126, 234, 0.5);
        animation: lasikPricingFloat 14s ease-in-out infinite;
    }

    .lasik-pricing__orb--2 {
        width: 340px;
        height: 340px;
        bottom: -10%;
        right: -5%;
        background: rgba(118, 75, 162, 0.45);
        animation: lasikPricingFloat 17s ease-in-out infinite reverse;
    }

    .lasik-pricing__orb--3 {
        width: 260px;
        height: 260px;
        top: 45%;
        left: 50%;
        background: rgba(0, 201, 255, 0.2);
        animation: lasikPricingFloat 12s ease-in-out infinite 2s;
    }

    @keyframes lasikPricingFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(16px, -20px) scale(1.05); }
    }

    .lasik-pricing .container {
        position: relative;
        z-index: 1;
    }

    .lasik-pricing__header {
        text-align: center;
        max-width: 720px;
        margin: 0 auto 56px;
        color: #fff;
    }

    .lasik-pricing__eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--lp-gold-light);
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 10px 20px;
        border-radius: 999px;
        margin-bottom: 22px;
        backdrop-filter: blur(8px);
    }

    .lasik-pricing__eyebrow::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--lp-cyan);
        box-shadow: 0 0 14px var(--lp-cyan);
    }

    .lasik-pricing__header h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(2.15rem, 4.5vw, 3.1rem);
        font-weight: 600;
        margin-bottom: 16px;
        color: #fff;
        letter-spacing: -0.02em;
        line-height: 1.15;
    }

    .lasik-pricing__header h2 em {
        font-style: italic;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.92);
    }

    .lasik-pricing__lede {
        font-size: 1.08rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.85);
        margin: 18px 0 0;
    }

    .lasik-pricing__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
        align-items: stretch;
        max-width: 1140px;
        margin: 0 auto;
    }

    .lasik-pricing__card {
        position: relative;
        display: flex;
        flex-direction: column;
        border-radius: 28px;
        overflow: visible;
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        animation: lasikPricingCardIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .lasik-pricing__card:nth-child(1) { animation-delay: 0.08s; }
    .lasik-pricing__card:nth-child(2) { animation-delay: 0.16s; }
    .lasik-pricing__card:nth-child(3) { animation-delay: 0.24s; }

    @keyframes lasikPricingCardIn {
        from { opacity: 0; transform: translateY(28px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .lasik-pricing__card-inner {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 36px 28px 32px;
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.7);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08), 0 24px 64px rgba(26, 18, 48, 0.22);
    }

    .lasik-pricing__card-accent {
        position: absolute;
        top: 0;
        left: 24px;
        right: 24px;
        height: 4px;
        border-radius: 4px 4px 0 0;
        z-index: 2;
    }

    .lasik-pricing__card--silver .lasik-pricing__card-accent {
        background: linear-gradient(90deg, #b8c0d4, #e8ecf4, #b8c0d4);
    }

    .lasik-pricing__card--gold .lasik-pricing__card-accent {
        background: linear-gradient(90deg, #a67c1a, #e8c96a, #c9922a, #e8c96a, #a67c1a);
    }

    .lasik-pricing__card--platinum .lasik-pricing__card-accent {
        background: linear-gradient(90deg, #667eea, #764ba2, #c9922a, #764ba2, #667eea);
    }

    .lasik-pricing__card:hover {
        transform: translateY(-10px);
    }

    .lasik-pricing__card--gold .lasik-pricing__card-inner {
        background: linear-gradient(165deg, #fffefb 0%, #fff 42%, #faf6ff 100%);
        border-color: rgba(201, 146, 42, 0.35);
    }

    .lasik-pricing__card--platinum {
        z-index: 3;
