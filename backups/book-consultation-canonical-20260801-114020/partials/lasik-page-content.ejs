<!-- JavaScript for Calculator Functionality -->
<script>
    // Cost Calculator Logic
    document.getElementById('prescription').addEventListener('change', updateCalculation);
    document.getElementById('current-costs').addEventListener('input', updateCalculation);
    document.getElementById('financing').addEventListener('change', updateCalculation);
    
    function updateCalculation() {
        const prescription = document.getElementById('prescription').value;
        const currentCosts = parseInt(document.getElementById('current-costs').value) || 500;
        const financing = document.getElementById('financing').value;
        
        // Base cost calculation
        let totalCost = 5400; // Default for mild
        if (prescription === 'moderate') totalCost = 5800;
        if (prescription === 'severe') totalCost = 6400;
        
        // Monthly payment calculation
        let monthlyPayment = totalCost;
        let months = 1;
        if (financing === '24') {
            months = 24;
            monthlyPayment = totalCost / 24;
        } else if (financing === '48') {
            months = 48;
            monthlyPayment = totalCost / 48;
        } else if (financing === '60') {
            months = 60;
            monthlyPayment = totalCost / 60;
        }
        
        // Break-even calculation
        const breakEven = totalCost / currentCosts;
        
        // 20-year savings
        const twentyYearCosts = currentCosts * 20;
        const savings = twentyYearCosts - totalCost;
        
        // Update display
        document.querySelector('.price').textContent = '$' + totalCost.toLocaleString();
        document.querySelector('.monthly').textContent = financing === 'cash' ? 
            'Paid in Full' : 
            '$' + Math.round(monthlyPayment) + '/mo';
        document.querySelector('.breakeven').textContent = breakEven.toFixed(1) + ' years';
        document.querySelector('.savings-message').textContent = 
            '💰 You\'ll save $' + savings.toLocaleString() + ' over 20 years!';
    }
    
    // Initialize calculation
    updateCalculation();
</script>

