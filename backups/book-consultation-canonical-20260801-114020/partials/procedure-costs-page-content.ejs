  <script>
    const data = [
      { id: 'smile', name: 'SMILE', low: 2400, high: 3600, per: 'eye',
        bullets: ['Dry-eye friendly for many', 'Back to most activities in 24–72 hours'] },
      { id: 'lasik', name: 'LASIK / Surface', low: 2400, high: 3408, per: 'eye',
        bullets: ['Technique and facility affect price', 'Enhancement policy reviewed at consult'] },
      { id: 'evo', name: 'EVO ICL', low: 4000, high: 6000, per: 'eye',
        bullets: ['Great for high prescriptions or thin corneas', 'Range reflects anesthesia/facility'] },
      { id: 'pie', name: 'PIE / LAL', low: 6912, high: 9912, per: 'eye',
        bullets: ['Advanced lens options tailored to goals', 'Warranty options available'] },
      { id: 'ctak', name: 'CTAK', low: 4992, high: 7992, per: 'eye',
        bullets: ['Transepithelial topography-guided plan', 'Medical necessity reviewed case-by-case'] },
      { id: 'cxl', name: 'CXL (Cross-linking)', low: 7488, high: 9888, per: 'eye',
        bullets: ['Stabilizes keratoconus/progression', 'Insurance rules may apply'] },
    ];

    const $ = (id) => document.getElementById(id);
    const cards = $('cards');
    const switcher = $('switch');
    let showFull = false;

    function money(n) {
      return '$' + Math.round(n).toLocaleString();
    }
    function monthlyString(low, high) {
      const L = low / 24;
      const H = high / 24;
      return L === H ? money(L) + '/mo' : money(L) + '–' + money(H) + '/mo';
    }
    function fullString(low, high, per) {
      return low === high
        ? money(low) + ' <span class="meta">per ' + per + '</span>'
        : money(low) + '–' + money(high) + ' <span class="meta">per ' + per + '</span>';
    }
    function render() {
      cards.innerHTML = '';
      data.forEach((d) => {
        const el = document.createElement('article');
        el.className = 'card procedure-card';
        el.setAttribute('data-procedure', d.id);
        const priceHTML = showFull
          ? fullString(d.low, d.high, d.per)
          : monthlyString(d.low, d.high) + ' <span class="meta">per ' + d.per + ' @ 24 mo 0%</span>';
        el.innerHTML =
          '<h3>' + d.name + '</h3>' +
          '<div class="price">' + priceHTML + '</div>' +
          '<ul class="bullets">' + d.bullets.map((b) => '<li>' + b + '</li>').join('') + '</ul>';
        cards.appendChild(el);
      });
    }
    render();

    function syncSwitchAria() {
      switcher.setAttribute('aria-checked', showFull ? 'true' : 'false');
    }
    syncSwitchAria();
    switcher.addEventListener('click', () => {
      showFull = !showFull;
      switcher.classList.toggle('on', showFull);
      syncSwitchAria();
      render();
    });
    switcher.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        switcher.click();
      }
    });

    const modal = $('modal');
    const openGuide = $('openGuide');
    function openModal() {
      modal.style.display = 'grid';
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
    openGuide.onclick = openModal;
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.style.display === 'grid') closeModal();
    });

    $('leadForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      e.target.style.display = 'none';
      $('success').style.display = 'block';
    });
  </script>
</div>
