<!-- Guru AI Chat Widget: load after first paint / idle to reduce main-thread work on mobile -->
<script>
(function () {
  function loadGuru() {
    if (document.querySelector('script[data-guru-chat]')) return;
    var s = document.createElement('script');
    s.src = '/public/js/guru-chat-embed.js';
    s.defer = true;
    s.setAttribute('data-guru-chat', '1');
    document.body.appendChild(s);
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadGuru, { timeout: 4000 });
  } else {
    window.addEventListener('load', function () { setTimeout(loadGuru, 0); });
  }
})();
</script>
