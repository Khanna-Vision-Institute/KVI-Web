<script>
(function () {
    document.addEventListener('DOMContentLoaded', function () {
        var stickyNav = document.getElementById('sticky-nav');
        if (stickyNav) {
            window.addEventListener('scroll', function () {
                if (window.scrollY > 50) stickyNav.classList.add('scrolled');
                else stickyNav.classList.remove('scrolled');
            });
        }
        document.querySelectorAll('a[href="#consult-form"]').forEach(function (anchor) {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                var el = document.querySelector(this.getAttribute('href'));
                if (el) el.scrollIntoView({ behavior: 'smooth' });
            });
        });
        document.querySelectorAll('.pterygium-landing .faq-item').forEach(function (item) {
            var q = item.querySelector('.faq-question');
            if (!q) return;
            q.addEventListener('click', function () {
                var open = item.classList.contains('open');
                document.querySelectorAll('.pterygium-landing .faq-item').forEach(function (i) { i.classList.remove('open'); });
                if (!open) item.classList.add('open');
            });
        });
    });
})();
</script>
