<%
/*
 * Site-wide trust band: four award badges plus verified magazine covers.
 * Included once from partials/header.ejs, immediately after the fixed header,
 * so every page that uses the shared header gets it. Not also included from
 * the footer.
 *
 * The header is position:fixed (logo 110px; home hero fallback padding is
 * var(--kvi-hero-offset, 142px)). The band is in normal flow with margin-top
 * equal to the header height so it is visible below the header instead of covered by it.
 * A small script then drops header-sized padding on the next block so titles
 * are not covered and are not pushed down by both the band and the old offset.
 *
 * Not included: Rising Star (removed on purpose), WHO Recognition, Man of the Year,
 * Celebrity Choice (no artwork; do not show as text).
 *
 * Award files: /public/images/awards/ (existing webp + png).
 * Covers: /public/images/press/ (resized down, never upscaled).
 */
var kviTrustAwards = [
  { file: 'readers-choice-award', ext: 'png', w: 300, h: 300,
    alt: "Daily News Readers' Best 2009 Readers' Choice award badge for Dr. Rajesh Khanna",
    cap: "Readers' Choice · 2009" },
  { file: 'newsweek-top-15-showcase', ext: 'png', w: 300, h: 250,
    alt: 'Newsweek Showcase badge: 15 Leaders in Laser Eye Surgery, recognizing Dr. Rajesh Khanna',
    cap: 'Newsweek · 15 Leaders' },
  { file: 'southern-california-top-lasik-surgeon', ext: 'png', w: 322, h: 300,
    alt: 'Southern California Top Doctors and Rising Stars 2020 badge for Rajesh Khanna, MD',
    cap: 'SoCal Top LASIK Surgeon' },
  { file: 'super-doctors-rajesh-khanna', ext: 'png', w: 383, h: 300,
    alt: 'Super Doctors Southern California 2023 badge for Rajesh Khanna, MD',
    cap: 'Super Doctors · 2023' }
];
var kviTrustCovers = [
  { file: 'yhc-magazine-june-2009', ext: 'jpg', w: 420, h: 508,
    alt: 'YHC Magazine cover, June 2009, featuring Dr. Rajesh Khanna',
    cap: 'YHC Magazine · June 2009' },
  { file: 'life-after-50-january-2009', ext: 'jpg', w: 420, h: 529,
    alt: 'Life After 50 magazine cover, Los Angeles, January 2009, featuring Dr. Rajesh Khanna',
    cap: 'Life After 50 · January 2009' },
  { file: 'beverly-hills-times-september-2007', ext: 'jpg', w: 420, h: 489,
    alt: 'Beverly Hills Times cover, September 2007, featuring Dr. Rajesh Khanna',
    cap: 'Beverly Hills Times · September 2007' }
];
%>
<style>
  .kvi-trust { background: #ffffff; border-bottom: 1px solid rgba(0,0,0,0.08); font-family: inherit; margin-top: var(--kvi-header-clearance, 142px); position: relative; z-index: 2; }
  .kvi-trust__inner { max-width: 1200px; margin: 0 auto; padding: 0.4rem 1rem 0.5rem; display: flex; align-items: flex-end; gap: 0.75rem; }
  .kvi-trust__label { flex: 0 0 auto; align-self: center; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #1e3c72; white-space: nowrap; text-decoration: none; }
  .kvi-trust__label:hover { text-decoration: underline; }
  .kvi-trust__list { display: flex; flex-wrap: nowrap; align-items: flex-end; gap: 0.85rem; list-style: none; margin: 0; padding: 0 0 0.1rem; overflow-x: auto; -webkit-overflow-scrolling: touch; flex: 1 1 auto; scrollbar-width: thin; }
  .kvi-trust__item { margin: 0; flex: 0 0 auto; text-align: center; }
  .kvi-trust__item img { display: block; width: auto; height: 84px; margin: 0 auto; object-fit: contain; }
  .kvi-trust__item--cover img { height: 118px; }
  .kvi-trust__cap { display: block; margin-top: 0.2rem; font-size: 0.68rem; font-weight: 600; line-height: 1.2; color: #2c3e50; max-width: 9.5rem; }
  @media (max-width: 768px) {
    .kvi-trust__inner { padding: 0.35rem 0.6rem 0.45rem; gap: 0.5rem; }
    .kvi-trust__label { font-size: 0.65rem; }
    .kvi-trust__item img { height: 72px; }
    .kvi-trust__item--cover img { height: 104px; }
  }
</style>
<section class="kvi-trust" aria-label="Awards and magazine covers featuring Dr. Rajesh Khanna">
  <div class="kvi-trust__inner">
    <a class="kvi-trust__label" href="/about/dr-khanna/credentials-awards/">Awards &amp; press</a>
    <ul class="kvi-trust__list">
      <% kviTrustAwards.forEach(function (a) { %>
      <li class="kvi-trust__item">
        <picture>
          <source srcset="/public/images/awards/<%= a.file %>.webp" type="image/webp">
          <img src="/public/images/awards/<%= a.file %>.<%= a.ext %>" alt="<%= a.alt %>" width="<%= a.w %>" height="<%= a.h %>" loading="eager" decoding="async">
        </picture>
        <span class="kvi-trust__cap"><%= a.cap %></span>
      </li>
      <% }); %>
      <% kviTrustCovers.forEach(function (a) { %>
      <li class="kvi-trust__item kvi-trust__item--cover">
        <picture>
          <source srcset="/public/images/press/<%= a.file %>.webp" type="image/webp">
          <img src="/public/images/press/<%= a.file %>.<%= a.ext %>" alt="<%= a.alt %>" width="<%= a.w %>" height="<%= a.h %>" loading="eager" decoding="async">
        </picture>
        <span class="kvi-trust__cap"><%= a.cap %></span>
      </li>
      <% }); %>
    </ul>
  </div>
</section>

<script>
(function () {
  function placeTrustBand() {
    var header = document.querySelector('.main-header');
    var band = document.querySelector('.kvi-trust');
    if (!header || !band) return;
    var h = header.offsetHeight;
    if (h > 0) {
      band.style.marginTop = h + 'px';
      document.documentElement.style.setProperty('--kvi-header-clearance', h + 'px');
    }
    var next = band.nextElementSibling;
    while (next && next.tagName === 'SCRIPT') next = next.nextElementSibling;
    if (!next) return;
    /* Home hero measures its own offset after this band and clears only the remainder. */
    if (next.classList && next.classList.contains('hero')) return;
    if (!next.dataset.kviOrigPadTop) {
      next.dataset.kviOrigPadTop = String(parseFloat(window.getComputedStyle(next).paddingTop) || 0);
    }
    var orig = parseFloat(next.dataset.kviOrigPadTop) || 0;
    if (orig >= 80 && orig <= h + 90) {
      next.style.paddingTop = Math.max(8, Math.round(orig - h)) + 'px';
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', placeTrustBand);
  else placeTrustBand();
  window.addEventListener('load', placeTrustBand);
  window.addEventListener('resize', placeTrustBand);
})();
</script>
